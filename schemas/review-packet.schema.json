{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/connorburgess/traceweave-spec/blob/main/schemas/review-packet.schema.json",
  "title": "Traceweave review-packet record (traceweave-review-packet-draft-2)",
  "description": "A separate record that links one region of a comparison report body to UC-2 origin or dependency evidence (spec/catalogue-report.md section 6.9, roadmap M2.7). It references the body by bodySha256 and the region by its region key; it is never part of the report. Each origin names the region side it describes, and its artifact digest must equal that side's digest in the body (for a historical copy, the source digest must equal the other side's). The licence is identified only by the SHA-256 of an archived licence text. There is no rights-verdict, permission, ownership, score, licence-identifier or free-text field. check_gates.py enforces the region and digest bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "origin",
    "region",
    "report",
    "reviewPacketVersion"
  ],
  "properties": {
    "reviewPacketVersion": {
      "const": "traceweave-review-packet-draft-2"
    },
    "report": {
      "$ref": "#/$defs/reportRef"
    },
    "region": {
      "$ref": "#/$defs/regionKey"
    },
    "origin": {
      "oneOf": [
        {
          "$ref": "#/$defs/ownOrigin"
        },
        {
          "$ref": "#/$defs/vendoredDependency"
        },
        {
          "$ref": "#/$defs/historicalCopy"
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "channelName": {
      "type": "string",
      "pattern": "^[a-z]+$",
      "maxLength": 32
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,64}$"
    },
    "reportRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodySha256"
      ],
      "properties": {
        "bodySha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "regionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "firstSeed",
        "mode",
        "referenceId"
      ],
      "properties": {
        "candidateId": {
          "$ref": "#/$defs/artifactId"
        },
        "firstSeed": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/count"
          }
        },
        "mode": {
          "$ref": "#/$defs/channelName"
        },
        "referenceId": {
          "$ref": "#/$defs/artifactId"
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textSha256"
      ],
      "properties": {
        "textSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "ownOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactSha256",
        "kind",
        "repositoryCommit",
        "side"
      ],
      "properties": {
        "kind": {
          "const": "own-origin"
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "repositoryCommit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "vendoredDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "licence",
        "package",
        "side",
        "upstreamArtifactSha256",
        "vendoredArtifactSha256"
      ],
      "properties": {
        "kind": {
          "const": "vendored-dependency"
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "vendoredArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"
            },
            "version": {
              "$ref": "#/$defs/label"
            }
          }
        },
        "upstreamArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "licence": {
          "$ref": "#/$defs/licence"
        }
      }
    },
    "historicalCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copyArtifactSha256",
        "kind",
        "licence",
        "side",
        "sourceArtifactSha256",
        "sourceCommit"
      ],
      "properties": {
        "kind": {
          "const": "historical-copy"
        },
        "side": {
          "$ref": "#/$defs/side"
        },
        "copyArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceArtifactSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceCommit": {
          "$ref": "#/$defs/commit"
        },
        "licence": {
          "$ref": "#/$defs/licence"
        }
      }
    },
    "side": {
      "enum": [
        "reference",
        "candidate"
      ]
    }
  }
}
