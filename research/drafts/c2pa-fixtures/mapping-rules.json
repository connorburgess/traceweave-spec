{
  "rulesVersion": "traceweave-c2pa-mapping-rules-draft-1",
  "mappingDocument": "../c2pa-mapping.md",
  "c2paVersion": "2.5",
  "c2paSpecification": "https://spec.c2pa.org/specifications/specifications/2.5/specs/C2PA_Specification.html",
  "notice": "Illustrative only: CBOR/JUMBF structures in JSON diagnostic form. Not a signed C2PA manifest, not produced or validated by any C2PA implementation, and no compatibility claim is made.",
  "claimWordsPattern": "(?i)\\b(compatible|interoperable|compliant|conformant|certified|c2pa-ready)\\b",
  "forbiddenKeys": [
    "similarityScore",
    "score",
    "confidence",
    "probability",
    "pValue",
    "compatible",
    "interoperable"
  ],
  "proposedNamespace": "org.traceweave",
  "proposedNamespaceStatus": "reverse-domain form of traceweave.org (registered 2026-11-23); every org.traceweave.* label, alg id and the predicate type are proposed identifiers, not registered anywhere",
  "standardLabels": [
    "c2pa.actions.v2",
    "c2pa.external-reference",
    "c2pa.hash.data",
    "c2pa.ingredient.v3",
    "c2pa.soft-binding"
  ],
  "hardBindingLabels": [
    "c2pa.hash.bmff.v3",
    "c2pa.hash.boxes",
    "c2pa.hash.collection.data",
    "c2pa.hash.data",
    "c2pa.hash.segment"
  ],
  "hashAlgorithms": [
    "sha256",
    "sha384",
    "sha512"
  ],
  "deprecated": [
    {
      "label": "c2pa.soft-binding",
      "pointer": "/url",
      "section": "16.3.7.1"
    },
    {
      "label": "c2pa.soft-binding",
      "pointer": "/blocks/*/scope/extent",
      "section": "16.3.7.1"
    },
    {
      "label": "c2pa.hash.data",
      "pointer": "/url",
      "section": "16.3.1.1"
    },
    {
      "action": "c2pa.watermarked",
      "section": "16.4.1.5"
    }
  ],
  "registeredSoftBindingAlgorithms": {
    "source": "https://github.com/c2pa-org/softbinding-algorithm-list/blob/b445c12ff537346dd7e4bd79524898b23814a89a/softbinding-algorithm-list.json",
    "sha256": "1ed282318ec66d24594eeca98eca8ebf7def3180a489dd228cda1569725558d1",
    "count": 79,
    "alg": [
      "ai.contentlens.audio.mono",
      "ai.contentlens.audio.stereo",
      "ai.contentlens.image.basewmk",
      "ai.contentlens.image.customwmk",
      "ai.contentlens.image.ensemblewmk",
      "ai.label4.watermark.fastermax",
      "ai.label4.watermark.phaseal",
      "ai.label4.watermark.walrus",
      "ai.steg.api",
      "ai.trufo.pawprint.fingerprint",
      "ai.trufo.pawprint.watermark",
      "ai.verda.watermark.audio.1",
      "ai.verda.watermark.image.1",
      "ai.verda.watermark.video.1",
      "app.overlai.watermark.1",
      "be.immostory.videoseal.1",
      "castLabs.watermark.1",
      "castLabs.watermark.1.session-v1",
      "com.adobe.flowmark.A",
      "com.adobe.hiermark.A",
      "com.adobe.icn.dense",
      "com.adobe.trustmark.C",
      "com.adobe.trustmark.F",
      "com.adobe.trustmark.P",
      "com.adobe.trustmark.Q",
      "com.aiwatermark.audioseal.1",
      "com.aiwatermark.pixelseal.1",
      "com.aiwatermark.videoseal.1",
      "com.art-koffee.phash.1",
      "com.cognitive-proof.vsrmark.1",
      "com.digicaps.fingerprint.1",
      "com.digimarc.validate.1",
      "com.doverunner.watermark.1",
      "com.dreamartfields.signature.2",
      "com.encypher.text.fingerprint.1",
      "com.encypher.text.watermark.1",
      "com.etchv.watermark.1",
      "com.evixar.eaw.1",
      "com.evixar.efp.type3.1",
      "com.imatag.lamark.v1",
      "com.joinmonolith.sha256",
      "com.markany.watermark.1",
      "com.mentaport.watermark.1",
      "com.microsoft.invismark.1",
      "com.microsoft.wavmark.1",
      "com.museblossom.contentsdefence.1",
      "com.nagra.nexguard.watermark.1",
      "com.originalpictures.audfprint.1",
      "com.originalpictures.audioseal.1",
      "com.originalpictures.chromaprint.1",
      "com.originalpictures.dinov2-lsh256.1",
      "com.originalpictures.dinov2.1",
      "com.originalpictures.pdq.1",
      "com.originalpictures.pixelseal-video.1",
      "com.originalpictures.pixelseal.1",
      "com.originalpictures.tmk-pdqf.1",
      "com.originalpictures.videoseal-image.1",
      "com.originalpictures.videoseal.1",
