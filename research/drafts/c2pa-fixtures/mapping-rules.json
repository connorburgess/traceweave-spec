      "com.writerslogic.text-watermark-semantic.1",
      "com.writerslogic.zwc-watermark.1",
      "com.writerslogic.zwc-watermark.2",
      "es.lumatrace",
      "eu.sasha.softbinding.v1",
      "io.blockfact.audio.watermark.32",
      "io.diker.sigi.v1",
      "io.iscc.v0",
      "me.deepmark.audio.vigil.128",
      "me.reconize.videoseal.1",
      "org.atsc.a336",
