  "kinds": {
    "soft-binding-image": {
      "source": "one entry of an image catalogue (traceweave-image-catalogue-draft-1, extraction-profile-image.md 8.1) with its catalogue-level fields",
      "side": "c2pa",
      "mapped": [
        {
          "tw": "/artifact/pdq/hash",
          "to": "/assertions/c2pa.soft-binding/blocks/0/value",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/artifact/sha256",
          "to": "/assertions/c2pa.hash.data/hash",
          "type": "bstr",
          "conv": "hex-to-bstr-whole-file"
        }
      ],
      "lossy": [
        "/artifact/pdq/quality",
        "/profile",
        "/matchingConfigSha256",
        "/artifact/decode/width",
        "/artifact/decode/height"
      ],
      "unmapped": [
        "/catalogueVersion",
        "/artifact/id",
        "/artifact/byteLength",
        "/artifact/pdq/status",
        "/artifact/iscc",
        "/artifact/decode/status",
        "/artifact/decode/format",
        "/artifact/decode/sourceMode",
        "/artifact/decode/iccPresent"
      ],
      "opaque": [],
      "conflicting": [
        "/artifact/decode/exifOrientation"
      ],
      "forbidden": [
        "/assertions/c2pa.soft-binding/blocks/0/scope/region"
      ]
    },
    "soft-binding-tokens": {
      "source": "one entry of a token catalogue (traceweave-catalogue-draft-2, catalogue-report.md 3) with its catalogue-level fields",
      "side": "c2pa",
      "mapped": [
        {
          "tw": "/artifact/channels/exact/fingerprints/*/hash",
          "to": "/assertions/c2pa.soft-binding/blocks/*/value",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/artifact/channels/normalized/fingerprints/*/hash",
          "to": "/assertions/c2pa.soft-binding__1/blocks/*/value",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/artifact/sha256",
          "to": "/assertions/c2pa.hash.data/hash",
          "type": "bstr",
          "conv": "hex-to-bstr-whole-file"
        }
      ],
      "lossy": [
        "/profile",
        "/extractionConfig",
        "/artifact/channels/exact/fingerprints/*/position",
        "/artifact/channels/normalized/fingerprints/*/position"
      ],
      "unmapped": [
        "/catalogueVersion",
        "/artifact/id",
        "/artifact/byteLength",
        "/artifact/status",
        "/artifact/tokenCount",
        "/artifact/channels/exact/kgramCount",
        "/artifact/channels/exact/partialWindow",
        "/artifact/channels/normalized/kgramCount",
        "/artifact/channels/normalized/partialWindow"
      ],
      "opaque": [],
      "conflicting": [
        "/artifact/channels/exact/fingerprints/*/span",
        "/artifact/channels/normalized/fingerprints/*/span"
      ],
      "forbidden": []
    },
    "custom-assertion-report": {
      "source": "a report document {body, provenance} (traceweave-report-draft-2, catalogue-report.md 6)",
      "side": "c2pa",
      "assertionLabel": "org.traceweave.comparison-report",
      "placement": "gathered_assertions",
      "mapped": [
        {
          "tw": "/body",
          "to": "/assertions/org.traceweave.comparison-report/body",
          "type": "bstr",
          "conv": "jcs-bytes"
        },
        {
          "tw": "/provenance/bodySha256",
          "to": "/assertions/org.traceweave.comparison-report/bodySha256",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/provenance/comparisonConfigSha256",
          "to": "/assertions/org.traceweave.comparison-report/comparisonConfigSha256",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/provenance/implementation/name",
          "to": "/assertions/org.traceweave.comparison-report/producer/name",
          "type": "tstr",
          "conv": "text"
        },
        {
          "tw": "/provenance/implementation/version",
          "to": "/assertions/org.traceweave.comparison-report/producer/version",
          "type": "tstr",
          "conv": "text"
        },
        {
          "tw": "/provenance/implementation/commit",
          "to": "/assertions/org.traceweave.comparison-report/producer/commit",
          "type": "tstr",
          "conv": "text"
        },
        {
          "tw": "/provenance/specCommit",
          "to": "/assertions/org.traceweave.comparison-report/specCommit",
          "type": "tstr",
          "conv": "text"
        },
        {
          "tw": "/provenance/generatedAt",
          "to": "/assertions/org.traceweave.comparison-report/generatedAt",
          "type": "tdate",
          "conv": "tdate"
        }
      ],
      "lossy": [],
      "unmapped": [],
      "opaque": [
        "/body/pairs/*/modes/*/outcome",
        "/body/pairs/*/outcome",
        "/body/pairs/*/modes/*/regions/*/status",
        "/body/comparison/minRegionDistinctHashes",
        "/body/inputs/suppressionCatalogueSha256",
        "/body/suppression",
        "/body/pairs/*/modes/*/containment",
        "/body/pairs/*/modes/*/similarity",
        "/body/rejection"
      ],
      "conflicting": [
        "/body/pairs/*/candidate/sha256",
        "/body/pairs/*/modes/*/regions/*/candidateSpan"
      ],
      "forbidden": [
        "/assertions/c2pa.soft-binding"
      ]
    },
    "intoto-statement-report": {
      "source": "a report document {body, provenance} carried as the predicate of an in-toto Statement v1 that names the candidate artifact and references the candidate's C2PA manifest",
      "side": "intoto",
      "predicateType": "https://traceweave.org/predicate/comparison-report/draft-2",
      "mapped": [
        {
          "tw": "/body",
          "to": "/predicate/body",
          "type": "object",
          "conv": "same"
        },
        {
          "tw": "/provenance",
          "to": "/predicate/provenance",
          "type": "object",
          "conv": "same"
        },
        {
          "tw": "/provenance/bodySha256",
          "to": "/predicate/bodySha256",
          "type": "hex64",
          "conv": "same"
        },
        {
          "tw": "/body/pairs/0/candidate/sha256",
          "to": "/subject/0/digest/sha256",
          "type": "hex64",
          "conv": "same"
        },
        {
          "tw": "/body/pairs/0/candidate/id",
          "to": "/subject/0/name",
          "type": "string",
          "conv": "same"
        }
      ],
      "lossy": [],
      "unmapped": [],
      "opaque": [],
      "conflicting": [],
      "forbidden": []
    },
    "mark-detection": {
      "source": "an illustrative mark-detection record in the lane 08 shared-container shape (no Traceweave schema exists; every value is invented)",
      "side": "c2pa",
      "mapped": [
        {
          "tw": "/decoded/payloadHex",
          "to": "/assertions/c2pa.soft-binding/blocks/0/value",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/carrier/variant",
          "to": "/assertions/c2pa.soft-binding/alg",
          "type": "tstr",
          "conv": "prefix:com.adobe.trustmark."
        },
        {
          "tw": "/region",
          "to": "/assertions/c2pa.soft-binding/blocks/0/scope/region",
          "type": "map",
          "conv": "pixel-rect"
        }
      ],
      "lossy": [
        "/region/imageWidth",
        "/region/imageHeight"
      ],
      "unmapped": [
        "/recordKind",
        "/artifact",
        "/carrier/algorithm",
        "/carrier/codeCommit",
        "/carrier/weightSha256",
        "/raw",
        "/decoded/status",
        "/decoded/ecc",
        "/statistic",
        "/outcome",
        "/searchScope",
        "/confidence"
      ],
      "opaque": [],
      "conflicting": [
        "/region/basis",
        "/decoded/payloadHex"
      ],
      "forbidden": []
    },
    "round-trip-image": {
      "source": "the soft-binding-image source, exported and imported back",
      "side": "c2pa",
      "rulesFrom": "soft-binding-image"
    },
    "registration-link": {
      "source": "a Traceweave M4 registration statement and tw1- reference linked from a sidecar C2PA manifest via org.traceweave.registration-link",
      "side": "c2pa",
      "assertionLabel": "org.traceweave.registration-link",
      "placement": "gathered_assertions",
      "mapped": [
        {
          "tw": "/statementSha256",
          "to": "/assertions/org.traceweave.registration-link/statementSha256",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/textReference",
          "to": "/assertions/org.traceweave.registration-link/textReference",
          "type": "tstr",
          "conv": "text"
        },
        {
          "tw": "/statement/predicate/registrationVersion",
          "to": "/assertions/org.traceweave.registration-link/registrationVersion",
          "type": "tstr",
          "conv": "text"
        },
        {
          "tw": "/statement/predicateType",
          "to": "/assertions/org.traceweave.registration-link/predicateType",
          "type": "tstr",
          "conv": "text"
        },
        {
          "tw": "/statement/subject/0/digest/sha256",
          "to": "/assertions/org.traceweave.registration-link/subjectSha256",
          "type": "bstr",
          "conv": "hex-to-bstr"
        },
        {
          "tw": "/statement/subject/0/digest/sha256",
          "to": "/assertions/c2pa.hash.data/hash",
          "type": "bstr",
          "conv": "hex-to-bstr-whole-file"
        },
        {
          "tw": "/relation",
          "to": "/assertions/org.traceweave.registration-link/relation",
          "type": "tstr",
          "conv": "text"
        }
      ],
      "lossy": [
        "/statement/predicate/claims/createdAt"
      ],
      "unmapped": [
        "/statement/_type",
        "/statement/subject/0/name",
        "/statement/predicate/contentKind",
        "/statement/predicate/nonce",
        "/statement/predicate/possession",
        "/statement/predicate/catalogue",
        "/statement/predicate/implementation",
        "/statement/predicate/specCommit"
      ],
      "opaque": [
        "/notShown"
      ],
      "conflicting": [
        "/timeEvidenceSummary"
      ],
      "forbidden": [
        "/assertions/c2pa.soft-binding",
        "/assertions/c2pa.hash.data/exclusions"
      ]
    }
  }
}
